# Copia este archivo a .env y ajusta los valores si lo necesitas.
# Si no existe .env, docker-compose usa estos mismos valores por defecto.

# SQL Server (contenedor `db`)
MSSQL_SA_PASSWORD=Bacros2026!Sql
DB_PORT=1433

# Base de datos y usuario de aplicación creados por db/init/01-schema.sql
DB_NAME=MantenimientoDB
DB_APP_USER=mantenimiento_app
DB_APP_PASSWORD=App2026!Mant

# Cadena de conexión de ejemplo (desde otro contenedor de la misma red de compose usa host `db`;
# desde tu máquina usa `localhost`):
# Server=db,1433;Database=MantenimientoDB;User Id=mantenimiento_app;Password=App2026!Mant;TrustServerCertificate=True;
